# =====================================================================
# Kwema Ride — environment
#
# On Railway, add the PostgreSQL and Redis plugins and reference their
# variables rather than pasting values:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
#   REDIS_URL    = ${{Redis.REDIS_URL}}
# Railway injects PORT itself — do not set it.
# =====================================================================

NODE_ENV=production

# --- Database --------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/kwema
# Railway's managed Postgres presents its own CA; set true there, false locally.
DATABASE_SSL=true
DB_POOL_MAX=20

# --- Redis -----------------------------------------------------------
REDIS_URL=redis://default:password@host:6379

# --- Auth ------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-min-32-chars
OFFER_TOKEN_SECRET=change-me-min-32-chars

# --- CORS / WebSocket origins ---------------------------------------
CORS_ORIGINS=https://admin.kwemaride.co.tz
WS_ALLOWED_ORIGINS=https://admin.kwemaride.co.tz

# --- SMS (Beem, NextSMS, Africa's Talking...) ------------------------
# Sender ID must be registered with TCRA before messages will deliver.
# Leave SMS_API_URL unset in development: OTPs are printed to the log.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=KWEMA

# --- Mobile money: aggregator selection ------------------------------
DEFAULT_AGGREGATOR=azampay

# --- AzamPay ---------------------------------------------------------
# Sandbox: https://authenticator-sandbox.azampay.co.tz
#          https://sandbox.azampay.co.tz
AZAMPAY_AUTH_BASE_URL=https://authenticator-sandbox.azampay.co.tz
AZAMPAY_CHECKOUT_BASE_URL=https://sandbox.azampay.co.tz
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
AZAMPAY_WEBHOOK_SECRET=

# --- Selcom ----------------------------------------------------------
SELCOM_BASE_URL=https://apigwtest.selcommobile.com
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR_ID=

# --- Card payments: DPO Pay (Direct Pay Online) ----------------------
# Sandbox: https://secure1.sandbox.directpay.online
DPO_BASE_URL=https://secure.3gdirectpay.com
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=

# Required for 3-D Secure redirects back from the card page. Must be the
# deployed https URL, no trailing slash.
PUBLIC_BASE_URL=https://kwema-ride-app-production.up.railway.app

# --- Maps ------------------------------------------------------------
# SERVER key: enable Directions, Distance Matrix, Geocoding, Places.
# Restrict it by IP to Railway's egress, never ship it in an APK — the
# mobile apps use a separate key restricted to the Maps SDK by bundle id.
GOOGLE_MAPS_SERVER_KEY=
MAPBOX_ACCESS_TOKEN=
